# Copy this file to .env and keep .env out of Git.

# Security placeholders (dev values only)
API_KEY=t16-dev-key
INTERNAL_TOKEN=t16-internal-secret

# Service discovery
REGISTRY_URL=http://127.0.0.1:8761
HEARTBEAT_INTERVAL_SECONDS=10
REGISTRY_TTL_SECONDS=30

# Ports
GATEWAY_PORT=8000
REGISTRY_PORT=8761
CANDIDATE_PORT=8001
JOB_PORT=8002
JOB_PORT_2=8012
APPLICATION_PORT=8003
RECRUITMENT_PORT=8004
NOTIFICATION_PORT=8005

# Resilience
HTTP_TIMEOUT_SECONDS=2
GATEWAY_TIMEOUT_SECONDS=3
CB_FAILURE_THRESHOLD=3
CB_OPEN_SECONDS=15
SAGA_RETRY_INTERVAL_SECONDS=10
